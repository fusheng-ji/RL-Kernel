 from __future__ import annotations
 
+import threading
+from collections import OrderedDict
+
 import torch
 
 from rl_engine.backends.extension import _C, _EXT_AVAILABLE
@@ -46,6 +49,58 @@ def _segment_tiles(index: torch.Tensor, num_rows: int):
     return sorted_pos, tile_begin.contiguous(), tile_end.contiguous(), seg_first_tile
 
 
+# Backward metadata of the last few row indices. Every norm and gated residual of a block (and of
+# every block of a forward pass that shares its index) reduces over the same segments, and building
+# the metadata costs a device sync (``bincount``, ``repeat_interleave``) per call.
+_TILE_CACHE_SIZE = 8
+_tile_cache: OrderedDict = OrderedDict()
+_tile_cache_lock = threading.Lock()
+
+
+def _cached_segment_tiles(sources, tag, build):
+    """``build()`` once per ``(sources, tag)``; the metadata is a function of their contents only.
+
+    ``sources`` are the tensors the metadata is computed from. An entry is valid while every source
+    is the same storage at the same autograd version, so an in-place edit (which bumps the version)
+    builds the metadata again. The entry keeps its sources alive, which stops the allocator from
+    reusing a freed address for a different index. The result is read-only for every consumer.
+    """
+
+    key = (
+        tag,
+        tuple(
+            (t.data_ptr(), t._version, tuple(t.shape), tuple(t.stride()), t.dtype, t.device)
+            for t in sources
+        ),
+    )
+    with _tile_cache_lock:
+        entry = _tile_cache.get(key)
+        if entry is not None:
+            _tile_cache.move_to_end(key)
+            return entry[1]
+    tiles = build()
+    with _tile_cache_lock:
+        _tile_cache[key] = (tuple(sources), tiles)
+        while len(_tile_cache) > _TILE_CACHE_SIZE:
+            _tile_cache.popitem(last=False)
+    return tiles
+
+
+def clear_segment_tiles_cache() -> None:
+    with _tile_cache_lock:
+        _tile_cache.clear()
+
+
+def _repeated_segment_tiles(index: torch.Tensor, rows: int, num_rows: int):
+    """``_segment_tiles`` of ``index`` repeated over ``rows`` rows, built once per index."""
+
+    return _cached_segment_tiles(
+        (index,),
+        ("repeat", rows, num_rows),
+        lambda: _segment_tiles(_repeat_positions(index, rows), num_rows),
+    )
+
+
 def _repeat_positions(index: torch.Tensor, rows: int) -> torch.Tensor:
     """Table row of every flattened position: ``index`` repeated ``rows // len(index)`` times.
 
@@ -75,8 +130,11 @@ class _H3AdaLNRowGatherCuda(torch.autograd.Function):
     def backward(ctx, grad_out):
         timestep_indices, token_tags = ctx.saved_tensors
         num_rows, rows_dtype = ctx.rows_meta
-        index = h3_adaln_indices(timestep_indices, token_tags)
-        tiles = _segment_tiles(index, num_rows)
+        tiles = _cached_segment_tiles(
+            (timestep_indices, token_tags),
+            ("gather", num_rows),
+            lambda: _segment_tiles(h3_adaln_indices(timestep_indices, token_tags), num_rows),
+        )
         grad_rows = _C.h3_adaln_row_gather_backward(grad_out.contiguous(), *tiles, rows_dtype)
         record_backward(
             "adaln_row_gather", kernel_id=BACKWARD_KERNEL_ID, impl=BACKWARD_IMPL, family="cuda"
