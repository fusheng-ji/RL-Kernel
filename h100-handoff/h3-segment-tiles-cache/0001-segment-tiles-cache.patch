diff --git a/tests/models/minimax_h3/test_h3_adaln_row_gather.py b/tests/models/minimax_h3/test_h3_adaln_row_gather.py
index 183ebbf6..cd4e9569 100644
--- a/tests/models/minimax_h3/test_h3_adaln_row_gather.py
+++ b/tests/models/minimax_h3/test_h3_adaln_row_gather.py
@@ -527,3 +527,109 @@ class TestNativeBackwardMetadata:
         args[name] = args[name].to("cuda:1")
         with pytest.raises(RuntimeError, match="tile metadata"):
             _C.h3_adaln_row_gather_backward(**args)
+
+
+@pytest.fixture
+def tile_cache():
+    from rl_engine.backends.cuda.model_specific.minimax_h3 import adaln_row_gather as mod
+
+    mod.clear_segment_tiles_cache()
+    yield mod
+    mod.clear_segment_tiles_cache()
+
+
+def _same_tiles(a, b):
+    return len(a) == len(b) and all(torch.equal(x, y) for x, y in zip(a, b))
+
+
+def test_segment_tiles_are_built_once_per_index_tensor(tile_cache, monkeypatch):
+    built = []
+    real = tile_cache._segment_tiles
+    monkeypatch.setattr(tile_cache, "_segment_tiles", lambda *a: built.append(1) or real(*a))
+    index = torch.tensor([2, 0, 1, 0, 2, 2, 1])
+    first = tile_cache._repeated_segment_tiles(index, 14, 3)
+    assert tile_cache._repeated_segment_tiles(index, 14, 3) is first
+    assert len(built) == 1
+    assert _same_tiles(first, real(index.repeat(2), 3))
+    # another repeat count or table size is another reduction
+    assert _same_tiles(tile_cache._repeated_segment_tiles(index, 7, 3), real(index, 3))
+    assert _same_tiles(tile_cache._repeated_segment_tiles(index, 14, 4), real(index.repeat(2), 4))
+    assert len(built) == 3
+
+
+def test_an_equal_index_in_other_storage_is_not_aliased_to_the_cached_one(tile_cache):
+    index = torch.tensor([1, 1, 0, 2])
+    first = tile_cache._repeated_segment_tiles(index, 4, 3)
+    twin = tile_cache._repeated_segment_tiles(index.clone(), 4, 3)
+    assert twin is not first and _same_tiles(twin, first)
+
+
+def test_an_index_edited_in_place_gets_fresh_tiles(tile_cache):
+    index = torch.tensor([0, 1, 1, 2, 0, 2])
+    before = tile_cache._repeated_segment_tiles(index, 6, 3)
+    index[0] = 2
+    after = tile_cache._repeated_segment_tiles(index, 6, 3)
+    assert not _same_tiles(after, before)
+    assert _same_tiles(after, tile_cache._segment_tiles(index, 3))
+
+
+def test_a_rejected_repeat_is_rejected_every_time_and_never_cached(tile_cache):
+    index = torch.tensor([0, 1, 2])
+    for _ in range(2):
+        with pytest.raises(ValueError, match="whole number of repeats"):
+            tile_cache._repeated_segment_tiles(index, 7, 3)
+    assert not tile_cache._tile_cache
+
+
+def test_the_tile_cache_stays_bounded(tile_cache):
+    index = torch.tensor([0, 1, 2, 1])
+    for rows in range(tile_cache._TILE_CACHE_SIZE + 5):
+        tile_cache._repeated_segment_tiles(index, 4, 3 + rows)
+    assert len(tile_cache._tile_cache) == tile_cache._TILE_CACHE_SIZE
+
+
+def _bf16(*shape, seed):
+    g = torch.Generator(device="cpu").manual_seed(seed)
+    return torch.randn(*shape, generator=g).to(torch.bfloat16).cuda().requires_grad_()
+
+
+@requires_cuda
+def test_cached_tiles_leave_the_norm_and_gate_gradients_bitwise_unchanged(tile_cache, monkeypatch):
+    from rl_engine.backends.cuda.model_specific.minimax_h3.gate_residual import (
+        H3GateResidualCudaOp,
+        h3_gate_residual_available,
+    )
+    from rl_engine.backends.cuda.model_specific.minimax_h3.rmsnorm import (
+        H3RMSNormCudaOp,
+        h3_rmsnorm_available,
+    )
+
+    if not (h3_gate_residual_available() and h3_rmsnorm_available()):
+        pytest.skip("rl_engine._C lacks the H3 gate-residual / rmsnorm kernels")
+    seq, hidden, table_rows = 600, 256, 6
+    index = (torch.arange(seq, device="cuda") * 7 % table_rows).contiguous()
+    gate_op, norm_op = H3GateResidualCudaOp(), H3RMSNormCudaOp()
+    x, y, w = _bf16(1, seq, hidden, seed=1), _bf16(1, seq, hidden, seed=2), _bf16(hidden, seed=3)
+    gate, shift, scale = (_bf16(table_rows, hidden, seed=s) for s in (4, 5, 6))
+
+    def run():
+        inputs = (x, y, w, gate, shift, scale)
+        for t in inputs:
+            t.grad = None
+        out = gate_op(x, y, gate, index) + norm_op.forward_modulated(x, w, shift, scale, index)
+        out.backward(torch.ones_like(out))
+        return [t.grad.clone() for t in inputs]
+
+    built = []
+    real = tile_cache._segment_tiles
+    monkeypatch.setattr(tile_cache, "_segment_tiles", lambda *a: built.append(1) or real(*a))
+    cached = run()
+    assert len(built) == 1  # the gate and the norm share one build
+    cached_again = run()
+    assert len(built) == 1
+    uncached = []
+    for _ in range(2):
+        tile_cache.clear_segment_tiles_cache()
+        uncached.append(run())
+    for grads in (cached_again, *uncached):
+        assert all(torch.equal(a, b) for a, b in zip(cached, grads))
