From 36ca09dcc714dc656d909534629a4507909c4fed Mon Sep 17 00:00:00 2001
From: Wenbo Ji <36562829+fusheng-ji@users.noreply.github.com>
Date: Thu, 29 Oct 2026 15:31:50 +0000
Subject: [PATCH 2/3] fix(qwen3-next): load the native recompute actor without
 DDP

create_actor(training=False) built the model through
setup_model_and_optimizer, which wraps it in DDP and allocates the FP32
gradient buffer. Recompute never trains and its caller already requires
optimizer=None and scheduler=None, but on 80 GB GPUs the buffer does not fit.
Build the model with get_model(wrap_with_ddp=False), install the linear
logprob capture, load the checkpoint and return (args, model, None, None).
The training=True path is unchanged.

Signed-off-by: Wenbo Ji <36562829+fusheng-ji@users.noreply.github.com>
---
 .../vime/providers/qwen3_next_vime_runtime.py | 20 ++++++++++++++++++-
 1 file changed, 19 insertions(+), 1 deletion(-)

diff --git a/rl_engine/integrations/orchestrators/vime/providers/qwen3_next_vime_runtime.py b/rl_engine/integrations/orchestrators/vime/providers/qwen3_next_vime_runtime.py
index 8888dc15..2fa974b4 100644
--- a/rl_engine/integrations/orchestrators/vime/providers/qwen3_next_vime_runtime.py
+++ b/rl_engine/integrations/orchestrators/vime/providers/qwen3_next_vime_runtime.py
@@ -177,10 +177,28 @@ def create_actor(checkpoint, *, training):
     if (args.vocab_size, args.padded_vocab_size) != (151936, 151936):
         raise ValueError("Tokenizer initialization changed the official LM-head vocabulary")
     from vime.backends.megatron_utils.checkpoint import load_checkpoint
-    from vime.backends.megatron_utils.model import setup_model_and_optimizer
 
     from rl_engine.models.qwen3_next.qwen3_next_logprob import install_vime_logprob_provider
 
+    if not training:
+        from megatron.core.enums import ModelType
+        from megatron.training.training import get_model
+        from vime.backends.megatron_utils.linear_logp_provider import linear_logp_provider_path
+        from vime.backends.megatron_utils.model import _install_linear_logp_capture, get_model_provider_func
+
+        model = get_model(
+            get_model_provider_func(args, "actor"),
+            ModelType.encoder_or_decoder,
+            wrap_with_ddp=False,
+        )
+        if linear_logp_provider_path(args) is not None:
+            _install_linear_logp_capture(model, args)
+        load_checkpoint(model, None, None, checkpointing_context={})
+        install_vime_logprob_provider()
+        return args, model, None, None
+
+    from vime.backends.megatron_utils.model import setup_model_and_optimizer
+
     model, optimizer, scheduler = setup_model_and_optimizer(args, role="actor")
     load_checkpoint(model, optimizer, scheduler, checkpointing_context={})
     install_vime_logprob_provider()
-- 
