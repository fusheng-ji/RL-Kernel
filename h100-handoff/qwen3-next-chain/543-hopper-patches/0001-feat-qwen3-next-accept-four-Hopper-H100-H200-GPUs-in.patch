From b2bda86c67d663047bbd2447a2a2f7c2ebed9a18 Mon Sep 17 00:00:00 2001
From: Wenbo Ji <36562829+fusheng-ji@users.noreply.github.com>
Date: Thu, 29 Oct 2026 15:31:33 +0000
Subject: [PATCH 1/3] feat(qwen3-next): accept four Hopper (H100/H200) GPUs in
 the chain preflight and L2 probe

The four-GPU guards in qwen3_next_preflight and the L2 gpu_probe accepted
only B200. Both now call one shared require_four_supported_gpus() in
qwen3_next_runtime, which accepts exactly four B200, H100 or H200 GPUs.
The CUDA 13.0.88 and runtime version checks are unchanged.

Signed-off-by: Wenbo Ji <36562829+fusheng-ji@users.noreply.github.com>
---
 .../models/qwen3_next/qwen3_next_l2.py           |  6 ++----
 .../models/qwen3_next/qwen3_next_preflight.py    |  8 ++------
 .../models/qwen3_next/qwen3_next_run.py          |  2 +-
 .../models/qwen3_next/qwen3_next_runtime.py      | 16 ++++++++++++++++
 4 files changed, 21 insertions(+), 11 deletions(-)

diff --git a/tools/validation/models/qwen3_next/qwen3_next_l2.py b/tools/validation/models/qwen3_next/qwen3_next_l2.py
index 75d0d93a..06692dc9 100644
--- a/tools/validation/models/qwen3_next/qwen3_next_l2.py
+++ b/tools/validation/models/qwen3_next/qwen3_next_l2.py
@@ -29,6 +29,7 @@ from qwen3_next_runtime import (  # noqa: E402
     file_digest,
     memory_limits,
     parse_memory_request,
+    require_four_supported_gpus,
     subprocess_failure,
     verify_checkpoint,
     verify_environment,
@@ -330,10 +331,7 @@ def run_process(command, *, log_path, timeout=4 * 3600, cleanup_grace_seconds=10
 def gpu_probe(output):
     import torch
 
-    if torch.cuda.device_count() != 4 or any(
-        "B200" not in torch.cuda.get_device_name(index) for index in range(4)
-    ):
-        raise RuntimeError("topology_mismatch: four allocated B200 GPUs required")
+    require_four_supported_gpus()
     atomic_json(
         output, {"uuids": [str(torch.cuda.get_device_properties(index).uuid) for index in range(4)]}
     )
diff --git a/tools/validation/models/qwen3_next/qwen3_next_preflight.py b/tools/validation/models/qwen3_next/qwen3_next_preflight.py
index 1fea2cfc..081d5e00 100644
--- a/tools/validation/models/qwen3_next/qwen3_next_preflight.py
+++ b/tools/validation/models/qwen3_next/qwen3_next_preflight.py
@@ -19,6 +19,7 @@ from qwen3_next_runtime import (
     failure_fields,
     memory_limits,
     parse_memory_request,
+    require_four_supported_gpus,
     subprocess_failure,
     verify_checkpoint,
     verify_environment,
@@ -94,12 +95,7 @@ def main():
         }
         atomic_json(output / "environment.json", inventory)
         run("environment-lock", [sys.executable, "-m", "pip", "freeze", "--all"])
-        if torch.cuda.device_count() != 4 or any(
-            "B200" not in torch.cuda.get_device_name(i) for i in range(4)
-        ):
-            raise RuntimeError(
-                "topology_mismatch: requires exactly four B200 GPUs in the execution step"
-            )
+        require_four_supported_gpus()
         if "V13.0.88" not in nvcc or torch.version.cuda != "13.0":
             raise RuntimeError(
                 "environment_mismatch: requires CUDA toolkit 13.0.88 and a CUDA 13.0 torch runtime"
diff --git a/tools/validation/models/qwen3_next/qwen3_next_run.py b/tools/validation/models/qwen3_next/qwen3_next_run.py
index 44d94cc9..9327d0f8 100644
--- a/tools/validation/models/qwen3_next/qwen3_next_run.py
+++ b/tools/validation/models/qwen3_next/qwen3_next_run.py
@@ -2,7 +2,7 @@
 # SPDX-License-Identifier: Apache-2.0
 # Copyright (c) 2026 RL-Kernel Contributors
 
-"""Run the Qwen3-Next full-model chain inside any allocation with four B200 GPUs.
+"""Run the Qwen3-Next full-model chain inside any allocation with four B200 or Hopper (H100/H200) GPUs.
 
     python tools/validation/models/qwen3_next/qwen3_next_run.py --stage all \\
         --runs-root <dir> --checkpoint <Qwen3-Next-80B-A3B-Instruct> --cuda-home <cuda-13.0>
diff --git a/tools/validation/models/qwen3_next/qwen3_next_runtime.py b/tools/validation/models/qwen3_next/qwen3_next_runtime.py
index 46edafa9..4edd286a 100644
--- a/tools/validation/models/qwen3_next/qwen3_next_runtime.py
+++ b/tools/validation/models/qwen3_next/qwen3_next_runtime.py
@@ -218,6 +218,22 @@ def verify_environment(expected, *, require_venv=False):
     return actual
 
 
+SUPPORTED_GPU_NAMES = ("B200", "H100", "H200")
+
+
+def require_four_supported_gpus():
+    """Require exactly four Blackwell B200 or Hopper H100/H200 GPUs."""
+    import torch
+
+    names = [torch.cuda.get_device_name(index) for index in range(torch.cuda.device_count())]
+    if len(names) != 4 or any(
+        not any(gpu in name for gpu in SUPPORTED_GPU_NAMES) for name in names
+    ):
+        raise RuntimeError(
+            f"topology_mismatch: requires exactly four GPUs of {SUPPORTED_GPU_NAMES}, got {names}"
+        )
+
+
 if __name__ == "__main__":
     print(json.dumps(current_identity(), sort_keys=True))
 
-- 
