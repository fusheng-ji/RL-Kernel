                0xFF7F,
                0x7F80,
                0xFF80,
                0x7F81,
                0x7FC1,
                0xFF81,
                0xFFFF,
            ),
            dtype=torch.uint16,
        )
        elements = 1
        for size in shape:
            elements *= size
        indices = (torch.arange(elements, dtype=torch.int64) + offset) % bits.numel()
