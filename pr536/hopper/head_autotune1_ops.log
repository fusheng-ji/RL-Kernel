    def _special_bf16(shape: tuple[int, ...], *, offset: int = 0) -> torch.Tensor:
        bits = torch.tensor(
            (
                0x0000,
                0x8000,
                0x0001,
                0x8001,
                0x007F,
                0x807F,
                0x0080,
                0x8080,
