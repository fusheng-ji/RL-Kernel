    def _special_bf16(shape: tuple[int, ...], *, offset: int = 0) -> torch.Tensor:
        bits = torch.tensor(
            (
                0x0000,
                0x8000,
                0x0001,
                0x8001,
                0x007F,
                0x807F,
                0x0080,
                0x8080,
                0x3F80,
                0xBF80,
                0x7F7F,
                0xFF7F,
                0x7F80,
                0xFF80,
                0x7F81,
                0x7FC1,
                0xFF81,
                0xFFFF,
            ),
            dtype=torch.uint16,
        )
        elements = 1
        for size in shape:
            elements *= size
        indices = (torch.arange(elements, dtype=torch.int64) + offset) % bits.numel()
